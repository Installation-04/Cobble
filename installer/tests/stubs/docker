#!/usr/bin/env bash
# Test stub for docker: logs every call and fakes the few answers the scripts rely on.
case "$*" in
  "compose version") echo "Docker Compose version v2.29.0" ; exit 0 ;;
  version*) echo "27.1.0" ; exit 0 ;;
esac
echo "$*" >>"${STUB_LOG:-/dev/null}"
case "$*" in
  *" ps -q caddy") exit 0 ;;
  *" ps -a --format"*)
    echo "caddy-init|exited||0"  # a one-shot that finished: not a failure
    for s in postgres redis litellm api worker ui caddy; do
      if [ "${STUB_BAD_CONTAINER:-}" = "$s" ]; then echo "$s|exited||${STUB_BAD_EXIT:-1}"; else echo "$s|running|healthy|0"; fi
    done
    if [ "${STUB_BAD_CONTAINER:-}" = "caddy-init" ]; then echo "caddy-init|exited||1"; fi
    ;;
  *"cobble.cli activation-link")
    if [ -n "${STUB_NO_ADMIN_LINK:-}" ]; then exit 1; fi
    echo "Activation link: http://10.0.0.5/activate?token=stubtoken"
    ;;
  *"cobble.cli reset-admin")
    echo "Activation link: http://10.0.0.5/activate?token=newtoken"
    ;;
esac
exit 0
