# Dev: plain HTTP. HTTPS (internal CA / Let's Encrypt) is configured by the installer.
{
	auto_https off
	# Reloaded by the module-manager when modules come and go. The socket lives in a volume only
	# Caddy and the module-manager mount; it is not reachable from any network.
	admin unix//run/caddy/admin.sock|0666
}

:80 {
	# Routes of the installed modules (generated by the module-manager). First, so that a module
	# wins over the v0.1 pack route of the same path while both exist.
	import /etc/caddy/routes/*.caddy

	# Optional v0.1 pack routes (/git, /ci); a glob that matches nothing is fine.
	import /etc/caddy/pack/*.caddy

	# Demos: served by the preview service when the pack provides its route (imported above),
	# otherwise by the API (fake pack mode, development and CI).
	handle /demo/* {
		reverse_proxy api:8000
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy ui:8080
	}
}
